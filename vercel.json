{
    "version": 2,
    "builds": [
        {
            "src": "app/app.ts",
            "use": "@vercel/node",
            "config": {
                "includeFiles": [
                    "dist/**"
                ]
            }
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "app/app.ts"
        },
        {
            "src": "/(.*)",
            "dest": "dist/app.js"
        }
    ],
    "outputDirectory": "dist"
}